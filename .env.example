# ============================================
# Biblioteca de AlexandrIA - variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# Lido pelo Next.js (runtime) e pelo Prisma CLI.
# ============================================

# Banco de dados (Prisma + SQLite)
DATABASE_URL="file:./dev.db"

# Segredos (troque em produção!)
JWT_SECRET=uma-chave-secreta-longa-e-aleatoria
SESSION_SECRET=outra-chave-secreta-longa-e-aleatoria

# IA via Ollama Cloud - OBRIGATÓRIO (https://ollama.com/settings/keys)
OLLAMA_API_KEY=

# Modelo do Ollama Cloud (opcional - padrão: gemma4:31b-cloud)
# Catálogo: https://ollama.com/library
OLLAMA_MODEL=gemma4:31b-cloud
